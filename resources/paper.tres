[ext_resource type="Script" path="res://scripts/battle/TalkOption.gd" id="3"]

[sub_resource type="Resource" id="Talk_look"]
script = ExtResource("3")
label = "살펴보기"
lines = Array[String](["낱장마다 다른 손글씨다. 같은 문장이 여러 번 겹쳐 적혀 있다.", "맨 위 장에 내 이름 비슷한 것이 적혀 있다. 획이 하나 모자란다."])
needs_light = true
dark_line = "무엇이 적혔는지 읽히지 않는다."
effect = 4
effect_line = "종이 사이로 빈 데가 보인다. 거기를 치면 무너진다."

[sub_resource type="Resource" id="Talk_read"]
script = ExtResource("3")
label = "읽어주기"
lines = Array[String](["소리 내어 읽었다. 종이가 잠깐 멎는다.", "다음 장을 읽었다. 탑이 한 뼘 낮아진다."])
needs_light = true
dark_line = "글자가 안 보이니 읽을 것도 없다."
effect = 1
effect_line = "마지막 장을 읽자 종이가 흩어진다. 다 읽힌 기록은 남을 이유가 없다."

[resource]
script = ExtResource("1")
