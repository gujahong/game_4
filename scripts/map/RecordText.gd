## 서가 하나에 해당하는 대사 한 판을 만든다.
##
## ### 다시 읽으면 전문이 다시 나온다 (회원님, 2026-08-19)
##
## 처음엔 *"이미 읽은 장이다"* 한 줄로 끝냈는데, 그러면 **다시 읽을 수가 없다.** 서가는
## 읽으라고 있는 것이고, 넷을 이어 붙여야 이야기가 되므로 되돌아가 확인할 수 있어야 한다.
##
## **해독은 볼 때마다 한다**(회원님). 이 글은 우리가 읽어낸 것이 아니라 **그 문자로 쓰여
## 있는 것**이라, 다시 펴면 다시 그 문자로 있다. 매번 풀리는 것이 맞다.
static func scene_for(index: int, _already_read: bool) -> DialogueScene:
	var scene := DialogueScene.new()
	scene.scene_id = "record_%d" % index

	var lines: Array[DialogueLine] = []
	var page: Array = PAGES[clampi(index, 0, PAGES.size() - 1)]
	for i in page.size():
		# **첫 줄은 종이를 묘사하고 나머지는 적힌 글이다.** 첫 줄만 서술체로 두면
		# "내가 보는 것"과 "적힌 것"이 갈린다 - 그리고 **적힌 것만 해독된다.**
		# 마지막 줄은 다 풀린 뒤 등불색으로 남는다. 넷 다 마지막 한 줄이 요점이다.
		var style := "narration"
		if i > 0:
			style = "record_key" if i == page.size() - 1 else "record"
		lines.append(_line(page[i], style))
	scene.lines = lines
	return scene


## 넷을 다 읽었을 때. **길이 열리는 것을 글로도 알린다** - 화면만 바뀌면 뭐가 열렸는지 모른다.
static func opened_scene() -> DialogueScene:
	var scene := DialogueScene.new()
	scene.scene_id = "record_opened"
	scene.lines = [
		_line("네 장을 다 읽었다.", "narration"),
		_line("안쪽에서 무언가 물러났다. 길이 열렸다.", "important"),
	]
	return scene


static func _line(text: String, style: String) -> DialogueLine:
	var line := DialogueLine.new()
	line.speaker = SPEAKER
	line.text = text
	line.style = style
	return line
